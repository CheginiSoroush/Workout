// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// وزن‌سنجی‌های روزانه برای پیگیری کاهش وزن
model WeightEntry {
  id        String   @id @default(cuid())
  weight    Float // کیلوگرم
  date      String   @unique // فرمت YYYY-MM-DD (یک رکورد در روز)
  note      String?
  createdAt DateTime @default(now())
}

// ثبت جلسات تمرین انجام‌شده (dayId: day1 | day2 | day3)
model WorkoutLog {
  id        String   @id @default(cuid())
  dayId     String // day1 | day2 | day3
  weekKey   String // شناسه هفته مثل 2025-W23
  completedAt DateTime @default(now())

  @@unique([dayId, weekKey])
}
